# Public Transport Route Helper for India - Root Environment Configuration

# Application
PROJECT_NAME="Public Transport Route Helper for India"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Default: SQLite (no setup required)
DATABASE_URL=sqlite:///./transit_app.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql://transit_user:transit_password@localhost:5432/transit_db

# AI Service (Mistral AI - Codestral)
# Get your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=codestral-latest

# Optional Legacy Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ML Model Configuration
ML_MODEL_DIR=ml/artifacts
DEFAULT_DELAY_MODEL=hist_gradient_boosting_v1.joblib

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
